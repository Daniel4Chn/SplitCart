{
  "name": "splitcart",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:python": ".venv/bin/python -m unittest discover -s python/tests -v",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "python3 scripts/local_db.py",
    "doctor": "tsx scripts/doctor.ts",
    "ops:backup": "tsx scripts/backup.ts",
    "ops:restore-check": "tsx scripts/restore-check.ts",
    "ops:maintenance": "tsx scripts/maintenance.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "next-auth": "4.24.15"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  },
  "type": "module"
}
